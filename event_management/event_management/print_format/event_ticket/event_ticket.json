 "html": "{% set attendee = frappe.db.get_value(\"Event Attendee\", doc.attendee, [\"attendee_name\", \"attendee_phone\"], as_dict=True) or {} %}\n{% set ready = doc.docstatus == 1 %}\n\n<div style=\"max-width:680px; margin:auto; font-family:Arial,sans-serif; color:#202b43; border:1px solid #e3e7ef; -webkit-print-color-adjust:exact;\">\n\n  <!-- Header -->\n  <table style=\"width:100%; background:#182d58; color:#ffffff;\" cellpadding=\"0\" cellspacing=\"0\">\n    <tr>\n      <td style=\"padding:34px 40px;\">\n        <div style=\"font-size:11px; letter-spacing:3px; font-weight:bold; color:#c5d4f5;\">EVENT MANAGEMENT</div>\n        <div style=\"font-size:28px; color:#f6d58c; margin-top:18px;\">&#10022;</div>\n        <div style=\"font-size:32px; font-weight:bold; margin:8px 0 6px;\">Your Event Pass</div>\n        <div style=\"font-size:14px; color:#d7e0f5;\">Your experience starts here.</div>\n      </td>\n    </tr>\n  </table>\n\n  <div style=\"padding:30px 40px;\">\n\n    <!-- Status -->\n    <table style=\"width:100%;\" cellpadding=\"0\" cellspacing=\"0\">\n      <tr>\n        <td style=\"font-size:10px; letter-spacing:1.5px; font-weight:bold; color:#8791a5;\">ADMISSION TICKET</td>\n        <td style=\"text-align:right;\">\n          {% if ready %}\n            <span style=\"background:#e4f6eb; color:#18764a; padding:6px 12px; border-radius:20px; font-size:12px; font-weight:bold;\">&#9679; Confirmed</span>\n          {% else %}\n            <span style=\"background:#fff2d8; color:#986817; padding:6px 12px; border-radius:20px; font-size:12px; font-weight:bold;\">&#9679; Pending</span>\n          {% endif %}\n        </td>\n      </tr>\n    </table>\n\n    <!-- Event -->\n    <div style=\"margin:26px 0;\">\n      <div style=\"font-size:10px; letter-spacing:1.5px; font-weight:bold; color:#8791a5;\">EVENT</div>\n      <div style=\"font-size:26px; font-weight:bold; color:#1c315d; margin-top:6px;\">{{ doc.event }}</div>\n    </div>\n\n    <!-- Details -->\n    <table style=\"width:100%; font-size:14px;\" cellpadding=\"0\" cellspacing=\"0\">\n      <tr>\n        <td style=\"width:50%; padding-bottom:20px; vertical-align:top;\">\n          <div style=\"font-size:10px; letter-spacing:1.5px; font-weight:bold; color:#8791a5;\">ATTENDEE NAME</div>\n          <b>{{ attendee.attendee_name or doc.attendee }}</b>\n        </td>\n        <td style=\"width:50%; padding-bottom:20px; vertical-align:top;\">\n          <div style=\"font-size:10px; letter-spacing:1.5px; font-weight:bold; color:#8791a5;\">EMAIL ADDRESS</div>\n          <b>{{ doc.attendee_email }}</b>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding-bottom:20px; vertical-align:top;\">\n          <div style=\"font-size:10px; letter-spacing:1.5px; font-weight:bold; color:#8791a5;\">PHONE NUMBER</div>\n          <b>{{ attendee.attendee_phone or \"\" }}</b>\n        </td>\n        <td style=\"padding-bottom:20px; vertical-align:top;\">\n          <div style=\"font-size:10px; letter-spacing:1.5px; font-weight:bold; color:#8791a5;\">TICKET TYPE</div>\n          <b>{{ doc.ticket_type }}</b>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding-bottom:20px; vertical-align:top;\">\n          <div style=\"font-size:10px; letter-spacing:1.5px; font-weight:bold; color:#8791a5;\">TICKET PRICE</div>\n          <b>&#8377;{{ doc.ticket_price }}</b>\n        </td>\n        <td style=\"padding-bottom:20px; vertical-align:top;\">\n          <div style=\"font-size:10px; letter-spacing:1.5px; font-weight:bold; color:#8791a5;\">REGISTRATION ID</div>\n          <b>{{ doc.name }}</b>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"vertical-align:top;\">\n          <div style=\"font-size:10px; letter-spacing:1.5px; font-weight:bold; color:#8791a5;\">TOTAL AMOUNT</div>\n          <b>&#8377;{{ doc.total_amount }}</b>\n        </td>\n        <td style=\"vertical-align:top;\">\n          <div style=\"font-size:10px; letter-spacing:1.5px; font-weight:bold; color:#8791a5;\">PAYMENT STATUS</div>\n          <b>{{ doc.payment_status or \"\" }}</b>\n        </td>\n      </tr>\n    </table>\n\n    <div style=\"border-top:1px dashed #cbd2df; margin:30px 0;\"></div>\n\n    <!-- QR -->\n    <div style=\"text-align:center;\">\n      {% if ready and doc.qr_code %}\n        <div style=\"font-size:21px; font-weight:bold; color:#1c315d; margin-bottom:8px;\">Your Entry QR Code</div>\n        <div style=\"font-size:13px; color:#7b8495;\">Present this QR code at the event entrance.</div>\n        <div style=\"margin:18px 0 8px;\">\n          <img src=\"{{ frappe.utils.get_url() }}{{ doc.qr_code }}\" style=\"width:200px; height:200px; padding:12px; border:1px solid #e3e7ef; border-radius:12px;\">\n        </div>\n        <div style=\"font-size:10px; letter-spacing:2px; font-weight:bold; color:#8993a6;\">KEEP THIS TICKET SAFE</div>\n      {% else %}\n        <div style=\"font-size:21px; font-weight:bold; color:#1c315d;\">Ticket Awaiting Approval</div>\n        <div style=\"font-size:13px; color:#7b8495; margin-top:8px;\">Your registration has been received. The QR code will be available once it is confirmed.</div>\n      {% endif %}\n    </div>\n\n    <!-- Footer -->\n    <div style=\"border-top:1px dashed #cbd2df; margin-top:26px; padding-top:20px; text-align:center;\">\n      <div style=\"font-size:10px; letter-spacing:1.5px; color:#8993a6;\">REGISTRATION ID</div>\n      <div style=\"font-size:13px; font-weight:bold; margin-top:6px;\">{{ doc.name }}</div>\n      <div style=\"font-size:12px; color:#8993a6; margin-top:14px;\">Thank you for registering. We look forward to seeing you!</div>\n    </div>\n\n  </div>\n</div>",
